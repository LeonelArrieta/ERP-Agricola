APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Argentina/Buenos_Aires
SESSION_LIFETIME=3600
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_agricola
DB_DATABASE=erp_agricola
DB_USERNAME=erp_app
DB_USER=erp_app
DB_PASSWORD=
LOG_LEVEL=DEBUG

# Facturacion electronica ARCA / WSFEv1
# mock | homologacion | produccion
ARCA_MODE=mock
ARCA_CUIT=
# Rutas absolutas fuera del repositorio. Nunca versionar certificados ni claves.
ARCA_CERT_PATH=
ARCA_KEY_PATH=
# Endpoints oficiales (vacio = usar los del ambiente seleccionado). Deben ser HTTPS.
ARCA_WSAA_URL=
ARCA_WSFE_URL=
ARCA_TIMEOUT=30
# false bloquea la emision hasta completar la habilitacion
ARCA_ALLOW_EMISSION=true
# Version del manual/WSDL contra la que se valido la integracion
ARCA_WSDL_VERSION=
# 1 = IVA Responsable Inscripto, 6 = Responsable Monotributo, 4 = IVA Sujeto Exento
ARCA_CONDICION_EMISOR=1
ARCA_PUNTO_VENTA_DEFAULT=1
